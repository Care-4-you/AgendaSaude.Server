generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ClinicHealthInsurance {
  id       Int    @id @default(autoincrement())
  value    String
  label    String
  clinicId Int
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model Clinic {
  id              Int                     @id @default(autoincrement())
  name            String
  phone           String
  cellPhone       String
  whatsapp        String
  hasNumber       Boolean                 @default(true)
  houseNumber     String
  acceptTerm      Boolean
  email           String                  @unique
  cnpj            String                  @unique
  password_hash   String
  isAuthenticated Boolean                 @default(false)
  address         String
  cep             String
  city            String
  state           String
  neighborhood    String
  complement      String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime                @default(now())
  healthInsurance ClinicHealthInsurance[]
  Consultation    Consultation[]
  Medic           Medic[]

  @@map("clinics")
}

model Pacient {
  id              Int            @id @default(autoincrement())
  name            String
  phone           String
  cellPhone       String
  whatsapp        String
  isWhatsapp      Boolean        @default(false)
  hasNumber       Boolean        @default(true)
  houseNumber     String
  acceptTerm      Boolean
  email           String         @unique
  cpf             String         @unique
  password_hash   String
  isAuthenticated Boolean        @default(false)
  address         String
  cep             String
  city            String
  state           String
  neighborhood    String
  complement      String?
  birth_date      DateTime
  gender          Json
  created_at      DateTime       @default(now())
  Consultation    Consultation[]
  Treatment       Treatment[]

  @@map("pacients")
}

model Medic {
  id              Int              @id @default(autoincrement())
  name            String
  cellPhone       String?
  cpf             String?          @unique
  phone           String
  whatsapp        String
  email           String
  password_hash   String
  isAuthenticated Boolean          @default(false)
  isWhatsapp      Boolean          @default(false)
  photo           String?
  gender          String
  city            String?          // mudou de obrigatório para opcional
  state           String?          // idem
  created_at      DateTime         @default(now())
  clinicId        Int?
  clinic          Clinic?          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  crm             MedicCrm[]
  specialty       MedicSpecialty[]
  Consultation    Consultation[]
  Treatment       Treatment[]

  @@map("medics")
}


model MedicSpecialty {
  id        Int    @id @default(autoincrement())
  specialty String
  medicId   Int
  medic     Medic  @relation(fields: [medicId], references: [id], onDelete: Cascade)
}

model MedicCrm {
  id      Int    @id @default(autoincrement())
  number  String 
  state   String
  medicId Int
  medic   Medic  @relation(fields: [medicId], references: [id], onDelete: Cascade)
}

model Consultation {
  id           Int         @id @default(autoincrement())
  consult_time DateTime
  created_at   DateTime    @default(now())
  updated_at   DateTime    @default(now())
  pacientId    Int
  medicId      Int
  clinicId     Int
  clinic       Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  medic        Medic       @relation(fields: [medicId], references: [id], onDelete: Cascade)
  pacient      Pacient     @relation(fields: [pacientId], references: [id], onDelete: Cascade)
  Treatment    Treatment[]

  @@map("consultations")
}

model Treatment {
  id            Int          @id @default(autoincrement())
  description   String
  attached      String
  created_at    DateTime     @default(now())
  updated_at    DateTime     @default(now())
  pacientId     Int
  medicId       Int
  consulationId Int
  consulation   Consultation @relation(fields: [consulationId], references: [id], onDelete: Cascade)
  medic         Medic        @relation(fields: [medicId], references: [id], onDelete: Cascade)
  pacient       Pacient      @relation(fields: [pacientId], references: [id], onDelete: Cascade)

  @@map("treatments")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  userType  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}
