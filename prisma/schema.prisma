// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ClinicSpecialty {
  id       Int    @id @default(autoincrement())
  value    String
  label    String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId Int
}

model ClinicHealthInsurance {
  id       Int    @id @default(autoincrement())
  value    String
  label    String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId Int
}

model Clinic {
  id               Int       @id @default(autoincrement())
  name             String
  phone            String
  cellPhone        String
  whatsapp         String
  hasNumber        Boolean   @default(true)
  houseNumber      String
  acceptTerm       Boolean
  email            String    @unique
  cnpj             String    @unique
  password_hash    String
  isAuthenticated  Boolean   @default(false)

  // Endereço
  address          String  
  cep              String 
  city             String
  state            String
  neighborhood     String
  complement       String? 

  // Relações para especialidades e planos de saúde
  specialty        ClinicSpecialty[] 
  healthInsurance  ClinicHealthInsurance[] 

  createdAt        DateTime  @default(now())

  // Outras relações
  Medic            Medic[]
  Consultation     Consultation[]

  @@map("clinics")
}

model Pacient {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String
  cellPhone        String
  whatsapp         String
  isWhatsapp       Boolean   @default(false)
  hasNumber        Boolean   @default(true)
  houseNumber      String
  acceptTerm       Boolean

  email            String   @unique
  cpf              String   @unique
  password_hash    String
  isAuthenticated  Boolean  @default(false)

  address          String
  cep              String
  city             String
  state            String
  neighborhood     String
  complement       String?

  birth_date       DateTime 
  gender           Json     

  created_at       DateTime @default(now())

  // Relações um-para-muitos
  Treatment        Treatment[]
  Consultation     Consultation[]

  @@map("pacients")
}

model Medic {
  id         Int              @id @default(autoincrement())
  name       String
  cpf        String           @unique
  phone      String
  email      String           @unique
  gender     String
  city       String
  state      String
  specialty  MedicSpecialty[]
  crm        MedicCrm[]
  created_at DateTime         @default(now())

  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Muitos-para-um
  clinicId Int

  Treatment    Treatment[] // Relação um-para-muitos
  Consultation Consultation[] // Um-para-muitos

  @@map("medics")
}

model MedicSpecialty {
  id        Int    @id @default(autoincrement())
  specialty String
  medic     Medic  @relation(fields: [medicId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  medicId   Int
}

model MedicCrm {
  id      Int    @id @default(autoincrement())
  number  String @unique
  state   String
  medic   Medic  @relation(fields: [medicId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  medicId Int
}

model Consultation {
  id           Int      @id @default(autoincrement())
  consult_time DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  pacient   Pacient @relation(fields: [pacientId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Muitos-para-um
  pacientId Int

  medic   Medic @relation(fields: [medicId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Muitos-para-um
  medicId Int

  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Muitos-para-um
  clinicId Int

  Treatment Treatment[] // Relação um-para-muitos

  @@map("consultations")
}

model Treatment {
  id          Int      @id @default(autoincrement())
  description String
  attached    String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  pacient   Pacient @relation(fields: [pacientId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relação muitos-para-um
  pacientId Int

  medic   Medic @relation(fields: [medicId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relação muitos-para-um
  medicId Int

  consulation   Consultation @relation(fields: [consulationId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relação muitos-para-um
  consulationId Int

  @@map("treatments")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  userType  String   // "pacient", "clinic"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}
